// Template for app/Secrets.swift (which is git-ignored).
// Copy this file to app/Secrets.swift and paste your real key below.
//
// The API key starts with "sk_" and is shown only when it is created or rotated. The key
// list in the dashboard shows each key's *id* instead — a bare 64-character hex string
// that looks like a key and is rejected by every request, which reads as the whole app
// going silent (see Speaker.fetchAudio).
//
// The agent ID is the public ElevenLabs agent AnalyzeView talks to. It needs no key of
// its own; the SDK trades it for a connection token without authenticating.

enum Secrets {
    static let elevenLabsAPIKey = "sk_PASTE_YOUR_ELEVENLABS_KEY_HERE"
    static let elevenLabsAgentID = "PASTE_YOUR_ELEVENLABS_AGENT_ID_HERE"
}
